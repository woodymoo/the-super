# ============================================================================
# The Super — environment configuration template
#
# Usage: cp the_super/.env.example the_super/.env  then fill in the [FILL] items.
# .env is already in .gitignore and will not be committed. Never paste it into a
# chat window or a screenshot.
#
# Markers:
#   [FILL]   required; nothing runs without it
#   [OPT]    the default is fine to start with
#   [LATER]  only needed on Cloud Run; ignore while local
# ============================================================================


# ---------------------------------------------------------------------------
# 1. The Gemini model — the agent's brain
# ---------------------------------------------------------------------------
# Get a key free at https://aistudio.google.com/app/apikey.
# Choose "Create API key in new project". Do not attach it to the GCP project
# holding your $150 of credits — the AI Studio free tier and GCP billing are two
# separate systems, and attaching it starts spending money instead.

GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# [FILL] the long string beginning with AIza
GOOGLE_API_KEY=


# ---------------------------------------------------------------------------
# 2. Gmail OAuth — the only channel for texts and email
# ---------------------------------------------------------------------------
# ⚠️ These two are [files], not environment values; what you set below is a path.
#
# Where credentials.json comes from (about 5 minutes):
#   1. Create a project at https://console.cloud.google.com/ (or reuse one)
#   2. APIs & Services -> Library -> search "Gmail API" -> Enable
#   3. APIs & Services -> OAuth consent screen -> External -> give it an app name
#      -> add your own Gmail under "Test users" (without this, authorization is denied)
#   4. APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#      -> application type **Desktop app** (not Web application)
#   5. Download the JSON, rename it credentials.json, and put it in the project root
#
# token.json takes care of itself — the first run opens a browser for you to
# authorize, and it is generated automatically afterwards.
#
# ⚠️ While the OAuth consent screen stays in "Testing", the refresh token expires
#    after 7 days. That is fine for a hackathon, but run it once before recording
#    the demo to confirm it hasn't expired.

GMAIL_CREDENTIALS_FILE=credentials.json            # [OPT] default is fine
GMAIL_TOKEN_FILE=token.json                        # [OPT] default is fine


# ---------------------------------------------------------------------------
# 3. Identity — the agent needs to know "who it is" so it doesn't treat its own
#    outbound messages as new incoming ones
# ---------------------------------------------------------------------------

# [FILL] the Gmail address you authorized
LANDLORD_EMAIL=
# [FILL] your Voice number, formatted +19175550100
GOOGLE_VOICE_NUMBER=


# ---------------------------------------------------------------------------
# 4. Where the digest goes — used by the digest and rent tasks in main.py
# ---------------------------------------------------------------------------
# This value isn't self-explanatory, so here is the detail.
#
# The Voice mechanism is "replying to a forwarded email = texting that person".
# So to text your own phone, an email thread between "your phone" and "the Voice
# number" has to exist first. How to create one:
#
#   1. In Voice, turn on Settings -> Messages -> "Forward messages to email"
#   2. Text your Voice number from your personal phone; the content doesn't
#      matter (e.g. "setup")
#   3. In Gmail, find the forwarded email from txt.voice.google.com
#   4. Open it; the hex string at the end of the browser address bar is the
#      thread id, e.g. .../#inbox/FMfcgzQbdRxKlZmnPqRsTuVwXyZ
#      <- take the part starting with FMfcg
#
# While you're there, save that email's raw source (the ⋮ menu at the top right
# -> "Show original", then select all and copy) to
# the_super/fixtures/sample_voice_email.txt — parse_voice_email() is written
# against that real sample, so keep it up to date if Google changes the format.

# [FILL] the thread id from step 4 above
LANDLORD_SMS_THREAD=


# ---------------------------------------------------------------------------
# 5. Polling behavior
# ---------------------------------------------------------------------------
# The incremental cursor is a set of processed Gmail message ids, kept in this
# file. (An earlier design used Gmail's historyId, but that has no baseline on
# the first run and drops messages silently once it skips.) On the first run the
# file doesn't exist and it falls back to "fetch the most recent N", with N set
# by POLL_INITIAL_LOOKBACK. Delete this file while debugging to replay the same
# batch of email.

GMAIL_HISTORY_FILE=the_super/fixtures/history_cursor.json   # [OPT]
POLL_INITIAL_LOOKBACK=20                           # [OPT] how many to fetch on the first run


# ---------------------------------------------------------------------------
# 6. Safety switch — strongly recommended for the first run
# ---------------------------------------------------------------------------
# With DRY_RUN=true: mail is read normally, classification runs normally, and the
# workflow runs normally, but every write (creating a draft, sending a text) only
# logs instead of executing.
# Use it to confirm the parsing and classification are right, then turn it off.

DRY_RUN=true                                       # [OPT] set to false once it works


# ---------------------------------------------------------------------------
# 7. Demo tuning
# ---------------------------------------------------------------------------
# The photo-waiting timeout. Production is 48 hours, but while recording the demo
# you can't wait two days for an "overdue ticket" to appear in the digest — set
# it to 0.05 (3 minutes) just before recording.
# Note: store.py currently hardcodes this as a constant; it needs changing to
# read this variable.

MEDIA_WAIT_HOURS=48                                # [OPT] lower it temporarily when recording the demo


# ---------------------------------------------------------------------------
# 8. Only needed on Cloud Run — ignore while local
# ---------------------------------------------------------------------------
# Locally the ledger and tickets live in fixtures/*.json. In the cloud the
# container filesystem is ephemeral, so this must become Firestore (the USE_LOCAL
# switch in store.py). The same applies to token.json: writing a refreshed token
# back to a local file is lost in the cloud, so it has to go to Firestore.

# GOOGLE_CLOUD_PROJECT=                            # [LATER]
# GOOGLE_CLOUD_LOCATION=us-central1                # [LATER]
# USE_FIRESTORE=false                              # [LATER]
