# ============================================================================
# The Super —— 环境配置模板
#
# 用法:cp the_super/.env.example the_super/.env  然后填下面标 【填】 的项。
# .env 已在 .gitignore 里,不会被提交。别把它贴进任何聊天窗口或截图。
#
# 标记说明:
#   【填】  必须填,不填跑不起来
#   【选】  可以先留默认值
#   【后】  上 Cloud Run 时才需要,本地阶段忽略
# ============================================================================


# ---------------------------------------------------------------------------
# 1. Gemini 模型 —— agent 的大脑
# ---------------------------------------------------------------------------
# key 从 https://aistudio.google.com/app/apikey 免费获取。
# 选 "Create API key in new project",不要绑到你那个有 $150 credits 的
# GCP 项目上 —— AI Studio 免费额度和 GCP 计费是两套,绑上去反而开始烧钱。

GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# 【填】AIza 开头的一长串
GOOGLE_API_KEY=


# ---------------------------------------------------------------------------
# 2. Gmail OAuth —— 收发短信和邮件的唯一通道
# ---------------------------------------------------------------------------
# ⚠️ 这两个是【文件】不是环境变量值,下面填的是路径。
#
# credentials.json 怎么来(约 5 分钟):
#   1. https://console.cloud.google.com/ 建个项目(或用现成的)
#   2. "API 和服务" → 库 → 搜 "Gmail API" → 启用
#   3. "API 和服务" → OAuth 同意屏幕 → External → 填个应用名
#      → "测试用户" 里把你自己的 Gmail 加进去(不加会被拒绝授权)
#   4. "API 和服务" → 凭据 → 创建凭据 → OAuth 客户端 ID
#      → 应用类型选 **桌面应用**(不是 Web 应用)
#   5. 下载 JSON,改名 credentials.json 放到项目根目录
#
# token.json 不用你管 —— 首次运行会弹浏览器让你授权,授权完自动生成。
#
# ⚠️ OAuth 同意屏幕停在 "测试" 状态时,refresh token 7 天过期。
#    对 hackathon 够用,但录 demo 前先跑一次确认没过期。

GMAIL_CREDENTIALS_FILE=credentials.json            # 【选】默认即可
GMAIL_TOKEN_FILE=token.json                        # 【选】默认即可


# ---------------------------------------------------------------------------
# 3. 身份 —— agent 需要知道"自己是谁",才能不把自己发的消息当成新消息处理
# ---------------------------------------------------------------------------

# 【填】你授权的那个 Gmail 地址
LANDLORD_EMAIL=
# 【填】你的 Voice 号,格式 +19175550100
GOOGLE_VOICE_NUMBER=


# ---------------------------------------------------------------------------
# 4. 日报发给谁 —— main.py 的 digest 和 rent 任务用
# ---------------------------------------------------------------------------
# 这个值不直观,单独说明。
#
# Voice 的机制是"回复转发邮件 = 发短信给对方"。所以要给你自己的手机发短信,
# 得先有一个"你的手机 ↔ Voice 号"的邮件线程。做法:
#
#   1. Voice 设置里打开 Settings → Messages → "Forward messages to email"
#   2. 用你的私人手机给你的 Voice 号发一条短信,内容随便(比如 "setup")
#   3. 去 Gmail 找到那封来自 txt.voice.google.com 的转发邮件
#   4. 点开,浏览器地址栏末尾那串十六进制就是 thread id
#      形如 .../#inbox/FMfcgzQbdRxKlZmnPqRsTuVwXyZ  ← 取 FMfcg 开头这段
#
# 顺手把这封邮件的原文存下来(邮件右上角 ⋮ → "显示原始邮件",全选复制),
# 保存到 the_super/fixtures/sample_voice_email.txt ——
# parse_voice_email() 要照着真实格式写,现在那个正则是猜的。

# 【填】上面第 4 步拿到的 thread id
LANDLORD_SMS_THREAD=


# ---------------------------------------------------------------------------
# 5. 轮询行为
# ---------------------------------------------------------------------------
# 增量游标用 Gmail historyId,存在这个文件里。首次运行文件不存在,
# 退化成"拉最近 N 封",N 由 POLL_INITIAL_LOOKBACK 决定。
# 调试时删掉这个文件就能重放同一批邮件。

GMAIL_HISTORY_FILE=the_super/fixtures/history_cursor.json   # 【选】
POLL_INITIAL_LOOKBACK=20                           # 【选】首次拉最近多少封


# ---------------------------------------------------------------------------
# 6. 安全开关 —— 强烈建议第一次跑时开着
# ---------------------------------------------------------------------------
# DRY_RUN=true 时:正常读邮件、正常分类、正常跑 workflow,
# 但所有写操作(建草稿、发短信)只打日志不真的执行。
# 先用它确认解析和分类是对的,再关掉。

DRY_RUN=true                                       # 【选】跑通后改 false


# ---------------------------------------------------------------------------
# 7. Demo 调节
# ---------------------------------------------------------------------------
# 等照片的超时时间。生产是 48 小时,但录 demo 时你不可能等两天才让
# "超时工单" 出现在日报里 —— 录制前临时改成 0.05(3 分钟)。
# 注意:store.py 现在把它写死成常量了,要改成读这个变量。

MEDIA_WAIT_HOURS=48                                # 【选】录 demo 时临时调小


# ---------------------------------------------------------------------------
# 8. Cloud Run 阶段才需要 —— 本地忽略
# ---------------------------------------------------------------------------
# 本地用 fixtures/*.json 存台账和工单。上云后容器文件系统是临时的,
# 必须换 Firestore(store.py 的 USE_LOCAL 开关)。
# token.json 也一样,刷新后写回本地文件在云上会丢,得存 Firestore。

# GOOGLE_CLOUD_PROJECT=                            # 【后】
# GOOGLE_CLOUD_LOCATION=us-central1                # 【后】
# USE_FIRESTORE=false                              # 【后】
